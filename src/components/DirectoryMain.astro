---
import type { Locale } from '../config/siteConfig';
import { VERIFIED_CATEGORIES, type DirectoryCategory } from '../data/verifiedDirectory';
import { CATEGORY_GUIDES } from '../data/categoryGuides';
import { getCategoryUrl, getCategorySeoMeta, getProfileUrl, HOME_COPY } from '../data/categorySeo';
import { stripLeadingEmoji, sanitizePhone, sanitizeWhatsApp } from '../utils/textUtils';
import Icon from './Icon.astro';
import { CITY_NAMES } from '../data/directoryLocations';
import { SELECTIONS, getSelectionUrl, type DirectorySelection } from '../data/directorySelections';

interface Props {
  currentLang: Locale;
  activeCategorySlug?: string;
  isCategoryPage?: boolean;
  selection?: Pick<DirectorySelection, 'slug' | 'guide' | 'listingNotes'> & {
    title: string;
    intro: string;
    category: DirectoryCategory;
  };
}

const {
  currentLang,
  activeCategorySlug = VERIFIED_CATEGORIES[0]?.slug || 'real-estate',
  isCategoryPage = false,
  selection,
} = Astro.props;
const activeCategory = VERIFIED_CATEGORIES.find((cat) => cat.slug === activeCategorySlug) || VERIFIED_CATEGORIES[0];
const categoryMeta = isCategoryPage ? getCategorySeoMeta(activeCategory, currentLang) : null;
const heroH1 = selection?.title || categoryMeta?.h1 || HOME_COPY[currentLang][0].split(' | ')[0];
const heroSubtitle = selection?.intro || categoryMeta?.subtitle || HOME_COPY[currentLang][1];
const displayedCategories = selection ? [selection.category] : isCategoryPage ? [activeCategory] : VERIFIED_CATEGORIES;
const displayedItems = displayedCategories.flatMap((cat) => cat.items);
const totalRenderedCount = displayedItems.length;
const cities = [...new Set(displayedItems.map((item) => item.city))];
const withWhatsApp = displayedItems.filter((item) => item.whatsapp && sanitizeWhatsApp(item.whatsapp)).length;
const withWebsite = displayedItems.filter((item) => item.website).length;
const canFilterWhatsApp = withWhatsApp > 0 && withWhatsApp < totalRenderedCount;
const canFilterWebsite = withWebsite > 0 && withWebsite < totalRenderedCount;
const guide = selection?.guide || (categoryMeta ? CATEGORY_GUIDES[activeCategorySlug] : undefined);
const selections = SELECTIONS.filter((entry) => (!isCategoryPage || entry.category === activeCategorySlug) && entry.slug !== selection?.slug);
const shortlistLabel = { en: 'Explore by need', el: 'Επιλογές ανά ανάγκη', ru: 'Подборки по задаче' }[currentLang];
const methodology = {
  en: ['About this directory', 'We group listings by service and city. Use the provider’s website to confirm current contact details, services, language and fees. For regulated professions, check the relevant public register.'],
  el: ['Σχετικά με τον κατάλογο', 'Ομαδοποιούμε τις καταχωρίσεις ανά υπηρεσία και πόλη. Επιβεβαιώστε στοιχεία, υπηρεσίες, γλώσσα και αμοιβές με τον πάροχο. Για ρυθμιζόμενα επαγγέλματα, ελέγξτε το δημόσιο μητρώο.'],
  ru: ['Как устроен каталог', 'Мы группируем компании по услугам и городам. Уточняйте контакты, услуги, язык и стоимость у компании. Для регулируемых профессий сверяйтесь с официальным реестром.'],
}[currentLang];

const t = {
  en: {
    searchLabel: 'Search Cyprus businesses',
    searchPlaceholder: 'Company or service',
    cityLabel: 'Filter by city',
    allCities: 'All Cities',
    foundLine: 'Showing',
    companiesWord: 'listings',
    allCategoriesTitle: 'Cyprus Industries',
    callBtn: 'Call',
    whatsappBtn: 'WhatsApp',
    mapBtn: 'Map',
    siteBtn: 'Website',
    profileBtn: 'Profile',
    filterWhatsapp: 'WhatsApp',
    filterWebsite: 'Website',
    resetBtn: 'Reset',
    emptyTitle: 'No matching businesses found',
    emptyDesc: 'Try clearing the search query or selecting All Cities.',
  },
  el: {
    searchLabel: 'Αναζήτηση επιχειρήσεων στην Κύπρο',
    searchPlaceholder: 'Εταιρεία ή υπηρεσία',
    cityLabel: 'Φίλτρο πόλης',
    allCities: 'Όλες οι πόλεις',
    foundLine: 'Εμφάνιση',
    companiesWord: 'καταχωρίσεις',
    allCategoriesTitle: 'Κλάδοι Κύπρου',
    callBtn: 'Κλήση',
    whatsappBtn: 'WhatsApp',
    mapBtn: 'Χάρτης',
    siteBtn: 'Ιστότοπος',
    profileBtn: 'Προφίλ',
    filterWhatsapp: 'WhatsApp',
    filterWebsite: 'Ιστότοπος',
    resetBtn: 'Επαναφορά',
    emptyTitle: 'Δεν βρέθηκαν αποτελέσματα',
    emptyDesc: 'Δοκιμάστε να καθαρίσετε την αναζήτηση ή να επιλέξετε Όλες τις πόλεις.',
  },
  ru: {
    searchLabel: 'Поиск компаний на Кипре',
    searchPlaceholder: 'Компания или услуга',
    cityLabel: 'Выбрать город',
    allCities: 'Все города',
    foundLine: 'Показано',
    companiesWord: 'компаний',
    allCategoriesTitle: 'Отрасли Кипра',
    callBtn: 'Позвонить',
    whatsappBtn: 'WhatsApp',
    mapBtn: 'Карта',
    siteBtn: 'Сайт',
    profileBtn: 'Профиль',
    filterWhatsapp: 'WhatsApp',
    filterWebsite: 'Сайт',
    resetBtn: 'Сбросить',
    emptyTitle: 'Ничего не найдено',
    emptyDesc: 'Попробуйте изменить запрос или выбрать «Все города».',
  },
}[currentLang];

const categoryBadgeIcons: Record<string, string> = {
  'real-estate': 'house',
  'lawyers-relocation': 'scale',
  'car-rental-mobility': 'car',
  'medical-dental': 'heart-pulse',
  'it-business-services': 'laptop',
  'renovation-construction': 'hammer',
};

---

<main class="mx-auto max-w-6xl px-4 pt-5 pb-2 sm:px-6">
  <section class="mb-5">
    {selection && categoryMeta && (
      <a href={getCategoryUrl(activeCategorySlug, currentLang)} class="mb-2 inline-flex min-h-8 items-center text-sm font-medium text-cti-text underline decoration-cti-gold underline-offset-4">
        {categoryMeta.h1}
      </a>
    )}
    <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-cti-text leading-tight">{heroH1}</h1>
    <p class="mt-2 text-base text-cti-muted max-w-3xl leading-relaxed">{heroSubtitle}</p>
  </section>

  {!isCategoryPage && (
    <nav id="directory" aria-label={t.allCategoriesTitle} class="mb-5 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
      {VERIFIED_CATEGORIES.map((cat) => (
        <a href={getCategoryUrl(cat.slug, currentLang)} class="flex min-h-12 items-center gap-2 rounded-xl border border-cti-border bg-cti-surface p-2.5 text-sm font-semibold leading-tight hover:border-cti-gold sm:p-3">
          <span aria-hidden="true" class="shrink-0">{cat.icon}</span>
          {stripLeadingEmoji(cat.titles[currentLang])}
        </a>
      ))}
    </nav>
  )}

  {selections.length > 0 && (
    <nav aria-label={shortlistLabel} class="mb-4 flex flex-wrap gap-x-4 gap-y-1">
      {selections.map((entry) => (
        <a href={getSelectionUrl(currentLang, entry.slug)} class="inline-flex min-h-9 items-center text-sm font-semibold text-cti-text underline decoration-cti-gold underline-offset-4 hover:decoration-current">
          {(isCategoryPage && entry.navLabel ? entry.navLabel : entry.name)[currentLang]}
        </a>
      ))}
    </nav>
  )}

  <!-- SEARCH & CITY FILTER BAR -->
  <section id="results" aria-label={t.searchLabel} class="mb-4 scroll-mt-20 rounded-2xl bg-cti-surface border border-cti-border p-3">
    <div class="flex flex-col md:flex-row gap-2.5">
      <div class="flex-1">
        <label for="directorySearch" class="sr-only">{t.searchLabel}</label>
        <input
          id="directorySearch"
          type="search"
          placeholder={t.searchPlaceholder}
          autocomplete="off"
          class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill min-h-11 px-3.5 py-2 text-base text-cti-text placeholder:text-cti-langMuted focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
        />
      </div>

      {(cities.length > 1 || canFilterWhatsApp || canFilterWebsite) && (
        <div class="flex flex-wrap items-center gap-2">
          {cities.length > 1 && (
            <div>
              <label for="cityFilter" class="sr-only">{t.cityLabel}</label>
              <select id="cityFilter" class="min-h-11 rounded-xl border border-cti-inputBorder bg-cti-pill px-2.5 text-sm font-medium text-cti-text focus-visible:ring-2 focus-visible:ring-cti-gold">
                <option value="all">{t.allCities}</option>
                {cities.map((city) => <option value={city}>{CITY_NAMES[city][currentLang]}</option>)}
              </select>
            </div>
          )}

          {canFilterWhatsApp && (
            <button
              type="button"
              id="filterWaBtn"
              aria-pressed="false"
              class="rounded-xl border border-cti-inputBorder bg-cti-pill min-h-11 px-2.5 py-2 text-sm font-medium text-cti-text hover:border-cti-gold transition-colors cursor-pointer"
            >
              {t.filterWhatsapp}
            </button>
          )}

          {canFilterWebsite && (
            <button
              type="button"
              id="filterWebBtn"
              aria-pressed="false"
              class="rounded-xl border border-cti-inputBorder bg-cti-pill min-h-11 px-2.5 py-2 text-sm font-medium text-cti-text hover:border-cti-gold transition-colors cursor-pointer"
            >
              {t.filterWebsite}
            </button>
          )}
        </div>
      )}
    </div>

    <div class="mt-1 flex items-center justify-between gap-2 text-sm text-cti-muted">
      <div aria-live="polite">
        {t.foundLine}: <strong id="visibleCount" class="text-cti-text">{totalRenderedCount}</strong> {t.companiesWord}
      </div>
      <button type="button" id="resetFiltersBtn" class="min-h-11 px-2 font-medium underline decoration-cti-gold underline-offset-4 hover:text-cti-text">
        {t.resetBtn}
      </button>
    </div>
  </section>

  <!-- COMPANY CARDS GRID -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
    {displayedCategories.map((cat) => {
      const catBadgeIcon = categoryBadgeIcons[cat.slug] || 'briefcase';
      return cat.items.map((item) => {
        const firstPhone = item.phones?.[0] || '';
        const cleanPhone = firstPhone ? sanitizePhone(firstPhone) : '';
        const cleanWa = item.whatsapp ? sanitizeWhatsApp(item.whatsapp) : '';
        const hasWa = Boolean(cleanWa);
        const hasWeb = Boolean(item.website);
        const itemSpecialization = item.agency?.[currentLang] || stripLeadingEmoji(cat.titles[currentLang]);
        const itemDescription = item.description[currentLang] || item.description.en;
        const note = selection?.listingNotes?.[item.id];
        const profileUrl = getProfileUrl(cat.slug, item.id, currentLang);
        const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
          `${item.name.en} ${item.address.en} Cyprus`
        )}`;

        return (
          <article
            data-company-card
            data-city={item.city}
            data-has-wa={hasWa ? 'true' : 'false'}
            data-has-web={hasWeb ? 'true' : 'false'}
            data-search-alias={[item.name.en, ...Object.values(CITY_NAMES[item.city])].join(' ')}
            class="bg-cti-surface border border-cti-border rounded-2xl overflow-hidden flex flex-col justify-between"
          >
            <div class="p-4 flex items-start gap-3">
              <div class="w-11 h-11 rounded-full bg-cti-badge flex items-center justify-center shrink-0 text-cti-text">
                <Icon name={catBadgeIcon} class="w-5 h-5" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-2">
                  <h2 class="text-base font-bold text-cti-text leading-snug">
                    <a href={profileUrl} class="hover:text-cti-gold transition-colors">
                      {item.name[currentLang] || item.name.en}
                    </a>
                  </h2>
                  <span class="shrink-0 text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-cti-bar border border-cti-divider text-cti-muted">
                    {CITY_NAMES[item.city][currentLang]}
                  </span>
                </div>

                {note ? (
                  <>
                    <p class="mt-1.5 text-sm leading-relaxed">{note.text[currentLang]}</p>
                    <a href={note.source} class="mt-1 inline-flex min-h-10 items-center text-sm font-semibold underline decoration-cti-gold underline-offset-4">
                      {{ en: 'Practice details', el: 'Υπηρεσίες μετανάστευσης', ru: 'Практика фирмы' }[currentLang]}
                    </a>
                  </>
                ) : (
                  <>
                    <p class="mt-1.5 text-sm font-medium text-cti-muted">{itemSpecialization}</p>
                    <p class="mt-1.5 text-sm text-cti-text/90 leading-relaxed line-clamp-3">{itemDescription}</p>
                  </>
                )}

                <div class="mt-2.5 flex items-start gap-1.5 text-[11px] text-cti-muted">
                  <Icon name="map-pin" class="w-3.5 h-3.5 shrink-0 mt-0.5 text-cti-gold" />
                  <span>{item.address[currentLang] || item.address.en}</span>
                </div>

              </div>
            </div>

            <div class="border-t border-cti-divider bg-cti-bar flex flex-wrap divide-x divide-cti-divider text-sm font-medium">
              <a href={profileUrl} class="min-h-11 px-3 flex flex-1 items-center justify-center font-semibold text-cti-text hover:bg-cti-catActive">
                {t.profileBtn}
              </a>
              {cleanPhone && (
                <a href={`tel:${cleanPhone}`} class="min-h-11 px-2 flex flex-1 items-center justify-center gap-1 text-cti-text hover:bg-cti-catActive">
                  <Icon name="phone" class="w-3.5 h-3.5 text-cti-open" />
                  {t.callBtn}
                </a>
              )}
              {hasWa && (
                <a href={`https://wa.me/${cleanWa}`} target="_blank" rel="noopener noreferrer" class="min-h-11 px-2 flex flex-1 items-center justify-center text-cti-text hover:bg-cti-catActive">
                  {t.whatsappBtn}
                </a>
              )}
              <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="min-h-11 px-2 flex flex-1 items-center justify-center text-cti-text hover:bg-cti-catActive">
                {t.mapBtn}
              </a>
              {hasWeb && (
                <a href={item.website} target="_blank" rel="noopener noreferrer" class="min-h-11 px-2 flex flex-1 items-center justify-center text-cti-text hover:bg-cti-catActive">
                  {t.siteBtn}
                </a>
              )}
            </div>
          </article>
        );
      });
    })}
  </div>

  <div id="emptyState" class="hidden mt-6 rounded-2xl border border-cti-border bg-cti-surface p-8 text-center">
    <p class="text-sm font-bold text-cti-text">{t.emptyTitle}</p>
    <p class="text-xs text-cti-muted mt-1">{t.emptyDesc}</p>
  </div>

  {guide && (
    <section id="guide" aria-labelledby="guide-heading" class="mt-8 rounded-2xl border border-cti-border bg-cti-surface p-4 sm:p-5">
      <h2 id="guide-heading" class="text-lg font-bold">{guide.question[currentLang]}</h2>
      <p class="mt-2 max-w-3xl text-base leading-relaxed">{guide.answer[currentLang]}</p>
      <a href={guide.source} class="mt-2 inline-flex min-h-11 items-center text-sm font-semibold underline decoration-cti-gold underline-offset-4">
        {guide.sourceLabel[currentLang]}
      </a>
    </section>
  )}

  <section id="methodology" class="mt-8 scroll-mt-20 border-t border-cti-divider pt-5">
    <h2 class="text-base font-bold">{methodology[0]}</h2>
    <p class="mt-2 max-w-3xl text-sm text-cti-muted leading-relaxed">{methodology[1]}</p>
  </section>
</main>

<script>
  (() => {
    const searchInput = document.querySelector<HTMLInputElement>('#directorySearch');
    const citySelect = document.querySelector<HTMLSelectElement>('#cityFilter');
    const waBtn = document.getElementById('filterWaBtn');
    const webBtn = document.getElementById('filterWebBtn');
    const resetBtn = document.getElementById('resetFiltersBtn');
    const counter = document.getElementById('visibleCount');
    const emptyState = document.getElementById('emptyState');
    const normalize = (value: string) => value.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-company-card]'), (card) => ({
      card,
      text: normalize(`${card.textContent || ''} ${card.dataset.searchAlias || ''}`),
    }));

    let onlyWa = false;
    let onlyWeb = false;

    function applyFilters() {
      const terms = normalize(searchInput?.value || '').trim().split(/\s+/).filter(Boolean);
      const city = citySelect?.value || 'all';
      let visible = 0;

      for (const { card, text } of cards) {
        const cardCity = card.getAttribute('data-city') || '';
        const hasWa = card.getAttribute('data-has-wa') === 'true';
        const hasWeb = card.getAttribute('data-has-web') === 'true';

        const matchQ = terms.every((term) => text.includes(term));
        const matchCity = city === 'all' || cardCity === city;
        const matchWa = !onlyWa || hasWa;
        const matchWeb = !onlyWeb || hasWeb;

        const show = matchQ && matchCity && matchWa && matchWeb;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }

      if (counter) {
        counter.textContent = String(visible);
      }
      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
      }
    }

    searchInput?.addEventListener('input', applyFilters);
    const url = new URL(window.location.href);
    const requestedCity = url.searchParams.get('city');
    if (citySelect && requestedCity && Array.from(citySelect.options).some((option) => option.value === requestedCity)) {
      citySelect.value = requestedCity;
    }
    applyFilters();

    function updateCity() {
      const currentUrl = new URL(window.location.href);
      const city = citySelect?.value;
      if (city && city !== 'all') currentUrl.searchParams.set('city', city);
      else currentUrl.searchParams.delete('city');
      window.history.replaceState(window.history.state, '', currentUrl);
      applyFilters();
    }
    citySelect?.addEventListener('change', updateCity);

    waBtn?.addEventListener('click', () => {
      onlyWa = !onlyWa;
      waBtn.setAttribute('aria-pressed', String(onlyWa));
      waBtn.classList.toggle('bg-cti-catActive', onlyWa);
      waBtn.classList.toggle('border-cti-gold', onlyWa);
      applyFilters();
    });

    webBtn?.addEventListener('click', () => {
      onlyWeb = !onlyWeb;
      webBtn.setAttribute('aria-pressed', String(onlyWeb));
      webBtn.classList.toggle('bg-cti-catActive', onlyWeb);
      webBtn.classList.toggle('border-cti-gold', onlyWeb);
      applyFilters();
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (citySelect) citySelect.value = 'all';
      onlyWa = false;
      onlyWeb = false;
      waBtn?.setAttribute('aria-pressed', 'false');
      webBtn?.setAttribute('aria-pressed', 'false');
      waBtn?.classList.remove('bg-cti-catActive', 'border-cti-gold');
      webBtn?.classList.remove('bg-cti-catActive', 'border-cti-gold');
      updateCity();
    });
  })();
</script>
