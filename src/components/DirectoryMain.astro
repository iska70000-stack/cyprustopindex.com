---
import type { Locale } from '../config/siteConfig';
import { VERIFIED_CATEGORIES } from '../data/verifiedDirectory';
import { CATEGORY_GUIDES, HOME_MARKET_GUIDE } from '../data/categoryGuides';
import { getCategoryUrl, getCategorySeoMeta } from '../data/categorySeo';
import { stripLeadingEmoji, sanitizePhone, sanitizeWhatsApp } from '../utils/textUtils';
import Icon from './Icon.astro';
import freshness from '../data/freshness.json';

interface Props {
  currentLang: Locale;
  activeCategorySlug?: string;
  isCategoryPage?: boolean;
}

const {
  currentLang,
  activeCategorySlug = VERIFIED_CATEGORIES[0]?.slug || 'real-estate',
  isCategoryPage = false,
} = Astro.props;

const formattedDate = (freshness.formattedDate as Record<Locale, string>)[currentLang] || freshness.lastVerified;
const totalItemsCount = VERIFIED_CATEGORIES.reduce((acc, cat) => acc + cat.items.length, 0);

const activeCategoryObj =
  VERIFIED_CATEGORIES.find((c) => c.slug === activeCategorySlug) || VERIFIED_CATEGORIES[0];

const categorySeoMeta = isCategoryPage
  ? getCategorySeoMeta(activeCategoryObj, currentLang)
  : null;

const heroTitles: Record<Locale, string> = {
  en: 'Verified Businesses & Services in Cyprus (2026)',
  el: 'Επαληθευμένες Επιχειρήσεις & Υπηρεσίες στην Κύπρο (2026)',
  ru: 'Проверенные бизнесы и сервисы на Кипре (2026)',
};

const heroSubtitles: Record<Locale, string> = {
  en: `Curated directory of ${totalItemsCount} verified companies across Limassol, Nicosia, Larnaca, and Paphos with transparent EUR (€) benchmarks.`,
  el: `Επιμελημένος κατάλογος ${totalItemsCount} επαληθευμένων εταιρειών σε Λεμεσό, Λευκωσία, Λάρνακα και Πάφο με τιμές αναφοράς σε EUR (€).`,
  ru: `Курируемый справочник ${totalItemsCount} проверенных компаний в Лимассоле, Никосии, Ларнаке и Пафосе с ориентирами цен в EUR (€).`,
};

const heroH1 = categorySeoMeta ? categorySeoMeta.h1 : heroTitles[currentLang];
const heroSubtitle = categorySeoMeta ? categorySeoMeta.subtitle : heroSubtitles[currentLang];

const t = {
  en: {
    searchLabel: 'Search Cyprus businesses',
    searchPlaceholder: 'Search company, service, or city (e.g. Limassol, Non-Dom, dental...)',
    cityLabel: 'Filter by city',
    allCities: 'All Cities',
    foundLine: 'Showing',
    companiesWord: 'verified listings',
    allCategoriesTitle: 'Cyprus Industries',
    callBtn: 'Call',
    whatsappBtn: 'WhatsApp',
    mapBtn: 'Map',
    siteBtn: 'Website',
    profileBtn: 'Dossier',
    filterWhatsapp: 'WhatsApp',
    filterWebsite: 'Website',
    filterFavs: 'Saved',
    resetBtn: 'Reset',
    rank1Badge: '#1 Verified Leader',
    verifiedStamp: `Verified: ${formattedDate}`,
    faqSectionTitle: 'Frequently Asked Questions (FAQ)',
    rulesTitle: 'Verification Methodology & Directory Principles',
    rulesText:
      'CyprusTopIndex is an independent public directory of registered businesses and licensed professionals in the Republic of Cyprus (Limassol, Nicosia, Larnaca, Paphos). Rankings cannot be purchased; entries are audited for licensing (CREAA, Cyprus Bar, ICPAC, ETEK, GeSY), direct contacts, and transparent EUR (€) pricing.',
    emptyTitle: 'No matching businesses found',
    emptyDesc: 'Try clearing the search query or selecting All Cities.',
  },
  el: {
    searchLabel: 'Αναζήτηση επιχειρήσεων στην Κύπρο',
    searchPlaceholder: 'Αναζήτηση εταιρείας, υπηρεσίας ή πόλης (π.χ. Λεμεσός, Non-Dom...)',
    cityLabel: 'Φίλτρο πόλης',
    allCities: 'Όλες οι πόλεις',
    foundLine: 'Εμφάνιση',
    companiesWord: 'επαληθευμένων καταχωρήσεων',
    allCategoriesTitle: 'Κλάδοι Κύπρου',
    callBtn: 'Κλήση',
    whatsappBtn: 'WhatsApp',
    mapBtn: 'Χάρτης',
    siteBtn: 'Ιστότοπος',
    profileBtn: 'Προφίλ',
    filterWhatsapp: 'WhatsApp',
    filterWebsite: 'Ιστότοπος',
    filterFavs: 'Αποθηκευμένα',
    resetBtn: 'Επαναφορά',
    rank1Badge: '#1 Επαληθευμένος Ηγέτης',
    verifiedStamp: `Έλεγχος: ${formattedDate}`,
    faqSectionTitle: 'Συχνές Ερωτήσεις (FAQ)',
    rulesTitle: 'Μεθοδολογία Επαλήθευσης & Αρχές Καταλόγου',
    rulesText:
      'Το CyprusTopIndex είναι ανεξάρτητος κατάλογος εγγεγραμμένων επιχειρήσεων και αδειούχων επαγγελματιών στην Κυπριακή Δημοκρατία (Λεμεσός, Λευκωσία, Λάρνακα, Πάφος). Οι θέσεις δεν πωλούνται· κάθε καταχώρηση ελέγχεται για άδειες (CREAA, Παγκύπριος Δικηγορικός Σύλλογος, ΣΕΛΚ, ΕΤΕΚ, ΓεΣΥ) και άμεση επικοινωνία.',
    emptyTitle: 'Δεν βρέθηκαν αποτελέσματα',
    emptyDesc: 'Δοκιμάστε να καθαρίσετε την αναζήτηση ή να επιλέξετε Όλες τις πόλεις.',
  },
  ru: {
    searchLabel: 'Поиск компаний на Кипре',
    searchPlaceholder: 'Поиск компании, услуги или города (напр.: Лимассол, Non-Dom, авто...)',
    cityLabel: 'Выбрать город',
    allCities: 'Все города',
    foundLine: 'Показано',
    companiesWord: 'проверенных компаний',
    allCategoriesTitle: 'Отрасли Кипра',
    callBtn: 'Позвонить',
    whatsappBtn: 'WhatsApp',
    mapBtn: 'Карта',
    siteBtn: 'Сайт',
    profileBtn: 'Досье',
    filterWhatsapp: 'WhatsApp',
    filterWebsite: 'Сайт',
    filterFavs: 'Избранное',
    resetBtn: 'Сбросить',
    rank1Badge: '№1 Проверенный лидер',
    verifiedStamp: `Проверено: ${formattedDate}`,
    faqSectionTitle: 'Частые вопросы (FAQ)',
    rulesTitle: 'Методология проверки и принципы каталога',
    rulesText:
      'CyprusTopIndex — независимый справочник зарегистрированных компаний и лицензированных специалистов Республики Кипр (Лимассол, Никосия, Ларнака, Пафос). Позиции в рейтинге не продаются: проверяются лицензии (CREAA, Cyprus Bar, ICPAC, ETEK, GeSY), прямые контакты и прозрачные цены в EUR (€).',
    emptyTitle: 'Ничего не найдено',
    emptyDesc: 'Попробуйте изменить запрос или выбрать «Все города».',
  },
}[currentLang];

const cityOptions = [
  { id: 'all', en: t.allCities, el: t.allCities, ru: t.allCities },
  { id: 'Limassol', en: 'Limassol', el: 'Λεμεσός', ru: 'Лимассол' },
  { id: 'Nicosia', en: 'Nicosia', el: 'Λευκωσία', ru: 'Никосия' },
  { id: 'Larnaca', en: 'Larnaca', el: 'Λάρνακα', ru: 'Ларнака' },
  { id: 'Paphos', en: 'Paphos', el: 'Πάφος', ru: 'Пафос' },
];

const categoryBadgeIcons: Record<string, string> = {
  'real-estate': 'house',
  'lawyers-relocation': 'scale',
  'car-rental-mobility': 'car',
  'medical-dental': 'heart-pulse',
  'it-business-services': 'laptop',
  'renovation-construction': 'hammer',
};

const activeGuide = isCategoryPage ? CATEGORY_GUIDES[activeCategorySlug] : HOME_MARKET_GUIDE;
const displayedCategories = isCategoryPage ? [activeCategoryObj] : VERIFIED_CATEGORIES;
const totalRenderedCount = displayedCategories.reduce((acc, c) => acc + c.items.length, 0);

const faqList = isCategoryPage
  ? CATEGORY_GUIDES[activeCategorySlug]?.faqs || []
  : Object.values(CATEGORY_GUIDES).flatMap((g) => g.faqs.slice(0, 1));
---

<div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
  <!-- HERO HEADER -->
  <section class="mb-6">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-cti-border bg-cti-bar px-3 py-1 text-[11px] font-mono text-cti-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-cti-open" aria-hidden="true"></span>
        <span>{t.verifiedStamp} • EUR (€)</span>
      </span>
      <span class="text-[11px] font-mono text-cti-muted">
        Limassol • Nicosia • Larnaca • Paphos
      </span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-cti-text leading-tight">
      {heroH1}
    </h1>
    <p class="mt-2 text-sm sm:text-base text-cti-muted max-w-3xl leading-relaxed">
      {heroSubtitle}
    </p>
  </section>

  <!-- CATEGORY NAVIGATION TILES -->
  <section id="directory" aria-labelledby="categories-heading" class="mb-6">
    <h2 id="categories-heading" class="text-[11px] font-mono uppercase tracking-widest text-cti-muted font-bold mb-2.5">
      {t.allCategoriesTitle}
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
      {VERIFIED_CATEGORIES.map((cat) => {
        const isActive = isCategoryPage && cat.slug === activeCategorySlug;
        return (
          <a
            href={getCategoryUrl(cat.slug, currentLang)}
            aria-current={isActive ? 'page' : undefined}
            class={`rounded-xl border p-3 transition-colors flex flex-col justify-between gap-1.5 focus-visible:outline-2 focus-visible:outline-cti-gold ${
              isActive
                ? 'bg-cti-catActive border-cti-gold text-cti-text shadow-sm'
                : 'bg-cti-surface border-cti-border text-cti-text hover:bg-cti-catInactive/60 hover:border-cti-gold/60'
            }`}
          >
            <div class="flex items-center justify-between">
              <span class="text-lg" aria-hidden="true">{cat.icon}</span>
              <span class="text-[11px] font-mono text-cti-muted">{cat.items.length}</span>
            </div>
            <span class="text-xs font-semibold leading-snug">
              {stripLeadingEmoji(cat.titles[currentLang])}
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- AEO / GEO BLOCK: CYPRUS MARKET PRICES & QUICK FACTS (2026) (ABOVE COMPANY LIST & FAQ) -->
  {activeGuide && (
    <aside
      aria-label="Cyprus Market Prices & Quick Facts (2026)"
      data-aeo-summary="true"
      class="mb-6 rounded-2xl bg-cti-surface border border-cti-border p-5 shadow-[0_1px_4px_rgba(35,31,27,0.04)]"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
        <div class="flex items-center gap-2">
          <Icon name="bar-chart" class="w-4 h-4 text-cti-gold shrink-0" />
          <h2 class="text-sm sm:text-base font-bold text-cti-text">
            {activeGuide.guideTitle[currentLang]}
          </h2>
        </div>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-cti-bar border border-cti-divider text-cti-muted">
          2026 • EUR (€)
        </span>
      </div>

      <p class="text-xs sm:text-sm text-cti-text leading-relaxed mb-4">
        {activeGuide.overview[currentLang]}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        {activeGuide.pricePoints.map((point) => (
          <div class="rounded-xl bg-cti-bar border border-cti-divider p-3">
            <div class="text-[11px] font-mono text-cti-muted uppercase tracking-wider">
              {point.label[currentLang]}
            </div>
            <div class="text-xs sm:text-sm font-bold text-cti-text mt-1 font-mono">
              {point.value[currentLang]}
            </div>
          </div>
        ))}
      </div>
    </aside>
  )}

  <!-- SEARCH & CITY FILTER BAR -->
  <section aria-label="Search and filters" class="mb-5 rounded-2xl bg-cti-surface border border-cti-border p-3.5">
    <div class="flex flex-col md:flex-row gap-2.5">
      <div class="flex-1">
        <label for="directorySearch" class="sr-only">{t.searchLabel}</label>
        <input
          id="directorySearch"
          type="search"
          placeholder={t.searchPlaceholder}
          autocomplete="off"
          class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text placeholder:text-cti-langMuted focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <div>
          <label for="cityFilter" class="sr-only">{t.cityLabel}</label>
          <select
            id="cityFilter"
            class="rounded-xl border border-cti-inputBorder bg-cti-pill px-3 py-2 text-xs sm:text-sm font-medium text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
          >
            {cityOptions.map((c) => (
              <option value={c.id}>{c[currentLang]}</option>
            ))}
          </select>
        </div>

        <button
          type="button"
          id="filterWaBtn"
          aria-pressed="false"
          class="rounded-xl border border-cti-inputBorder bg-cti-pill px-3 py-2 text-xs font-medium text-cti-text hover:border-cti-gold transition-colors cursor-pointer"
        >
          {t.filterWhatsapp}
        </button>

        <button
          type="button"
          id="filterWebBtn"
          aria-pressed="false"
          class="rounded-xl border border-cti-inputBorder bg-cti-pill px-3 py-2 text-xs font-medium text-cti-text hover:border-cti-gold transition-colors cursor-pointer"
        >
          {t.filterWebsite}
        </button>

        <button
          type="button"
          id="resetFiltersBtn"
          class="rounded-xl border border-cti-border bg-cti-bar px-3 py-2 text-xs font-medium text-cti-muted hover:text-cti-text transition-colors cursor-pointer"
        >
          {t.resetBtn}
        </button>
      </div>
    </div>

    <div class="mt-2.5 flex items-center justify-between text-xs text-cti-muted">
      <div id="resultsCounter" aria-live="polite" class="font-mono">
        {t.foundLine}: <strong class="text-cti-text">{totalRenderedCount}</strong> {t.companiesWord}
      </div>
    </div>
  </section>

  <!-- COMPANY CARDS GRID -->
  <main id="companyCardsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
    {displayedCategories.map((cat) => {
      const catBadgeIcon = categoryBadgeIcons[cat.slug] || 'briefcase';
      return cat.items.map((item) => {
        const isRank1 = item.pinned_rank || item.rank === 1;
        const firstPhone = item.phones?.[0] || '';
        const cleanPhone = firstPhone ? sanitizePhone(firstPhone) : '';
        const cleanWa = item.whatsapp ? sanitizeWhatsApp(item.whatsapp) : '';
        const hasWa = Boolean(cleanWa);
        const hasWeb = Boolean(item.website);
        const itemSpecialization = item.agency?.[currentLang] || stripLeadingEmoji(cat.titles[currentLang]);
        const itemDescription = item.description[currentLang] || item.description.en;
        const profileUrl = `${getCategoryUrl(cat.slug, currentLang)}${item.id}/`;
        const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
          `${item.name.en} ${item.address.en} Cyprus`
        )}`;

        return (
          <article
            data-company-card
            data-city={item.city}
            data-has-wa={hasWa ? 'true' : 'false'}
            data-has-web={hasWeb ? 'true' : 'false'}
            data-search-text={[
              item.name.en,
              item.name.el,
              item.name.ru,
              item.city,
              item.agency?.en || '',
              item.agency?.el || '',
              item.agency?.ru || '',
              item.description.en,
              item.description.el,
              item.description.ru,
              item.address.en,
            ]
              .join(' ')
              .toLowerCase()}
            class={`bg-cti-surface border ${
              isRank1 ? 'border-cti-gold ring-1 ring-cti-gold/30' : 'border-cti-border'
            } rounded-2xl overflow-hidden shadow-[0_1px_4px_rgba(35,31,27,0.04)] flex flex-col justify-between`}
          >
            <div class="p-4 flex items-start gap-3">
              <div class="w-11 h-11 rounded-full bg-cti-badge flex items-center justify-center shrink-0 text-cti-text">
                <Icon name={catBadgeIcon} class="w-5 h-5" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="text-[15px] font-bold text-cti-text leading-snug">
                    <a href={profileUrl} class="hover:text-cti-gold transition-colors">
                      {item.name[currentLang] || item.name.en}
                    </a>
                  </h3>
                  <span class="shrink-0 text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-cti-bar border border-cti-divider text-cti-muted">
                    {item.city}
                  </span>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 mt-1">
                  {isRank1 && (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-[#F4EBD9] border border-cti-catActive text-[10.5px] font-bold text-cti-gold">
                      <span aria-hidden="true">🏆</span>
                      <span>{t.rank1Badge}</span>
                    </span>
                  )}
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-cti-bar border border-cti-divider text-[10.5px] font-semibold text-cti-open">
                    <span aria-hidden="true">✔</span>
                    <span>{currentLang === 'el' ? 'Επαληθευμένο' : currentLang === 'ru' ? 'Проверено' : 'Verified'}</span>
                  </span>
                  {item.rating && (
                    <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-md bg-cti-pill border border-cti-divider text-[10.5px] font-mono font-bold text-cti-text">
                      <span class="text-cti-star" aria-hidden="true">★</span>
                      <span>{item.rating.toFixed(1)}</span>
                    </span>
                  )}
                </div>

                <p class="mt-1.5 text-[11.5px] font-medium text-cti-muted">{itemSpecialization}</p>
                <p class="mt-1.5 text-xs text-cti-text/90 leading-relaxed line-clamp-3">{itemDescription}</p>

                <div class="mt-2.5 flex items-start gap-1.5 text-[11px] text-cti-muted">
                  <Icon name="map-pin" class="w-3.5 h-3.5 shrink-0 mt-0.5 text-cti-gold" />
                  <span>{item.address[currentLang] || item.address.en}</span>
                </div>

                {item.languages && (
                  <div class="mt-2 flex flex-wrap gap-1">
                    {item.languages.map((lng) => (
                      <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-cti-pill border border-cti-divider text-cti-muted">
                        {lng}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>

            <div class="border-t border-cti-divider bg-cti-bar grid grid-cols-4 divide-x divide-cti-divider text-[11px] font-medium">
              {cleanPhone ? (
                <a
                  href={`tel:${cleanPhone}`}
                  class="py-2.5 px-1 flex items-center justify-center gap-1 text-cti-text hover:bg-cti-catInactive/40 transition-colors"
                >
                  <Icon name="phone" class="w-3.5 h-3.5 text-cti-open" />
                  <span>{t.callBtn}</span>
                </a>
              ) : (
                <span class="py-2.5 px-1 flex items-center justify-center text-cti-muted/40">{t.callBtn}</span>
              )}

              {hasWa ? (
                <a
                  href={`https://wa.me/${cleanWa}`}
                  target="_blank"
                  rel="nofollow noopener noreferrer"
                  class="py-2.5 px-1 flex items-center justify-center font-semibold text-cti-open hover:bg-cti-catInactive/40 transition-colors"
                >
                  {t.whatsappBtn}
                </a>
              ) : (
                <a
                  href={profileUrl}
                  class="py-2.5 px-1 flex items-center justify-center font-semibold text-cti-gold hover:bg-cti-catInactive/40 transition-colors"
                >
                  {t.profileBtn}
                </a>
              )}

              <a
                href={mapUrl}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="py-2.5 px-1 flex items-center justify-center text-cti-text hover:bg-cti-catInactive/40 transition-colors"
              >
                {t.mapBtn}
              </a>

              {hasWeb ? (
                <a
                  href={item.website}
                  target="_blank"
                  rel="nofollow noopener noreferrer"
                  class="py-2.5 px-1 flex items-center justify-center font-semibold text-cti-text hover:bg-cti-catInactive/40 transition-colors"
                >
                  {t.siteBtn} ↗
                </a>
              ) : (
                <a
                  href={profileUrl}
                  class="py-2.5 px-1 flex items-center justify-center font-semibold text-cti-gold hover:bg-cti-catInactive/40 transition-colors"
                >
                  {t.profileBtn} →
                </a>
              )}
            </div>
          </article>
        );
      });
    })}
  </main>

  <div id="emptyState" class="hidden mt-6 rounded-2xl border border-cti-border bg-cti-surface p-8 text-center">
    <p class="text-sm font-bold text-cti-text">{t.emptyTitle}</p>
    <p class="text-xs text-cti-muted mt-1">{t.emptyDesc}</p>
  </div>

  <!-- FAQ SECTION -->
  {faqList.length > 0 && (
    <section aria-labelledby="faq-heading" class="mt-10 pt-6 border-t border-cti-divider">
      <h2 id="faq-heading" class="text-xs font-mono uppercase tracking-widest text-cti-text font-bold flex items-center gap-1.5 mb-3">
        <Icon name="help-circle" class="w-4 h-4 text-cti-gold" />
        <span>{t.faqSectionTitle}</span>
      </h2>
      <div class="space-y-2">
        {faqList.map((faq) => (
          <details class="group rounded-xl bg-cti-surface border border-cti-border transition open:border-cti-gold">
            <summary class="flex items-center justify-between cursor-pointer px-4 py-3 text-xs sm:text-sm font-semibold text-cti-text select-none list-none [&::-webkit-details-marker]:hidden">
              <span class="pr-3 leading-snug">{faq.question[currentLang]}</span>
              <Icon name="chevron-down" class="w-4 h-4 text-cti-muted group-open:rotate-180 transition-transform shrink-0" />
            </summary>
            <div class="px-4 pb-3.5 pt-2 text-xs sm:text-sm text-cti-muted border-t border-cti-divider leading-relaxed">
              {faq.answer[currentLang]}
            </div>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- METHODOLOGY & PRINCIPLES -->
  <section id="methodology" aria-labelledby="methodology-heading" class="mt-8 pt-6 border-t border-cti-divider">
    <details class="group rounded-xl bg-cti-surface border border-cti-border transition open:border-cti-gold">
      <summary class="flex items-center justify-between cursor-pointer px-4 py-3 text-xs sm:text-sm font-semibold text-cti-text select-none list-none [&::-webkit-details-marker]:hidden">
        <span id="methodology-heading" class="flex items-center gap-2">
          <Icon name="shield-check" class="w-4 h-4 text-cti-gold" />
          <span>{t.rulesTitle}</span>
        </span>
        <Icon name="chevron-down" class="w-4 h-4 text-cti-muted group-open:rotate-180 transition-transform shrink-0" />
      </summary>
      <div class="px-4 pb-4 pt-2 text-xs sm:text-sm text-cti-muted border-t border-cti-divider leading-relaxed">
        {t.rulesText}
      </div>
    </details>
  </section>
</div>

<script define:vars={{ foundLine: t.foundLine, companiesWord: t.companiesWord }}>
  (() => {
    const searchInput = document.getElementById('directorySearch');
    const citySelect = document.getElementById('cityFilter');
    const waBtn = document.getElementById('filterWaBtn');
    const webBtn = document.getElementById('filterWebBtn');
    const resetBtn = document.getElementById('resetFiltersBtn');
    const counter = document.getElementById('resultsCounter');
    const emptyState = document.getElementById('emptyState');
    const cards = Array.from(document.querySelectorAll('[data-company-card]'));

    let onlyWa = false;
    let onlyWeb = false;

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const city = citySelect?.value || 'all';
      let visible = 0;

      for (const card of cards) {
        const text = card.getAttribute('data-search-text') || '';
        const cardCity = card.getAttribute('data-city') || '';
        const hasWa = card.getAttribute('data-has-wa') === 'true';
        const hasWeb = card.getAttribute('data-has-web') === 'true';

        const matchQ = !q || text.includes(q);
        const matchCity = city === 'all' || cardCity === city;
        const matchWa = !onlyWa || hasWa;
        const matchWeb = !onlyWeb || hasWeb;

        const show = matchQ && matchCity && matchWa && matchWeb;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }

      if (counter) {
        counter.innerHTML = `${foundLine}: <strong class="text-cti-text">${visible}</strong> ${companiesWord}`;
      }
      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
      }
    }

    searchInput?.addEventListener('input', applyFilters);
    citySelect?.addEventListener('change', applyFilters);

    waBtn?.addEventListener('click', () => {
      onlyWa = !onlyWa;
      waBtn.setAttribute('aria-pressed', String(onlyWa));
      waBtn.classList.toggle('bg-cti-catActive', onlyWa);
      waBtn.classList.toggle('border-cti-gold', onlyWa);
      applyFilters();
    });

    webBtn?.addEventListener('click', () => {
      onlyWeb = !onlyWeb;
      webBtn.setAttribute('aria-pressed', String(onlyWeb));
      webBtn.classList.toggle('bg-cti-catActive', onlyWeb);
      webBtn.classList.toggle('border-cti-gold', onlyWeb);
      applyFilters();
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (citySelect) citySelect.value = 'all';
      onlyWa = false;
      onlyWeb = false;
      waBtn?.setAttribute('aria-pressed', 'false');
      webBtn?.setAttribute('aria-pressed', 'false');
      waBtn?.classList.remove('bg-cti-catActive', 'border-cti-gold');
      webBtn?.classList.remove('bg-cti-catActive', 'border-cti-gold');
      applyFilters();
    });
  })();
</script>
