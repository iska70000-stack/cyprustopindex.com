---
import { activePreset, type Locale } from '../config/siteConfig';
import { resolveCategoryByRouteParam, getCategoryUrl } from '../data/categorySeo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

interface Props {
  title: string;
  description: string;
  currentLang: Locale;
  currentPath?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  currentLang,
  currentPath = '',
  schema,
  noindex = !activePreset.allowIndexing,
} = Astro.props;

const canonicalPathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPathname, activePreset.siteUrl).href;
const submitPath = `/${currentLang}/submit/`;
const showMobileAddBusiness = canonicalPathname !== submitPath;
const addBusinessLabel = {
  en: 'Add Business',
  el: 'Προσθήκη επιχείρησης',
  ru: 'Добавить бизнес',
}[currentLang];

function getAlternateUrl(targetLang: Locale): string {
  const segments = Astro.url.pathname.split('/').filter(Boolean);
  if (segments.length === 0) {
    return `${activePreset.siteUrl}/${targetLang}/`;
  }
  if (segments.length >= 2 && activePreset.locales.includes(segments[0] as Locale)) {
    const matchedCat = resolveCategoryByRouteParam(segments[1], segments[0] as Locale);
    if (matchedCat) {
      const catUrl = getCategoryUrl(matchedCat.slug, targetLang);
      if (segments.length >= 3) {
        return `${activePreset.siteUrl}${catUrl}${segments[2]}/`;
      }
      return `${activePreset.siteUrl}${catUrl}`;
    }
  }
  if (activePreset.locales.includes(segments[0] as Locale)) {
    segments[0] = targetLang;
  } else {
    segments.unshift(targetLang);
  }
  return `${activePreset.siteUrl}/${segments.join('/')}/`;
}

const defaultLangUrl = getAlternateUrl(activePreset.defaultLocale);
const organizationId = `${activePreset.siteUrl}/#organization`;
const logoUrl = `${activePreset.siteUrl}/favicon.png`;
const socialImageUrl = `${activePreset.siteUrl}/social-card.png`;
const ogLocales: Record<Locale, string> = { en: 'en_GB', el: 'el_CY', ru: 'ru_RU' };
const combinedSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: activePreset.siteName,
    url: activePreset.siteUrl,
    logo: logoUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${activePreset.siteUrl}/#website`,
    name: activePreset.siteName,
    url: activePreset.siteUrl,
    inLanguage: activePreset.locales,
    publisher: { '@id': organizationId },
  },
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!doctype html>
<html lang={currentLang} dir="ltr" class="scroll-smooth antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="zFzrjxTXaXUfxpdqwswtKnFutcCFAxcR79bFGTsZSq0" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/json" href={`${activePreset.siteUrl}/api/directory.json`} title="CyprusTopIndex Verified Open Dataset (JSON)" />
    <link rel="alternate" type="text/plain" href={`${activePreset.siteUrl}/llms.txt`} title="CyprusTopIndex LLM Summary" />

    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    {activePreset.locales.map((lang) => (
      <link rel="alternate" hreflang={lang} href={getAlternateUrl(lang)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultLangUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={activePreset.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocales[currentLang]} />
    {activePreset.locales.filter((lang) => lang !== currentLang).map((lang) => (
      <meta property="og:locale:alternate" content={ogLocales[lang]} />
    ))}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={activePreset.siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <JsonLd schema={combinedSchemas} />
  </head>
  <body class:list={[
    'bg-cti-bg text-cti-text font-sans min-h-screen flex flex-col selection:bg-cti-catActive selection:text-cti-text',
    showMobileAddBusiness && 'pb-[calc(4.5rem+env(safe-area-inset-bottom))] sm:pb-0',
  ]}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-cti-text focus:px-3 focus:py-2 focus:text-xs focus:font-semibold focus:text-cti-surface"
    >
      Skip to main content
    </a>

    <Header currentLang={currentLang} currentPath={currentPath} />

    <div id="main-content" class="flex-1">
      <slot />
    </div>

    {showMobileAddBusiness && (
      <a
        href={submitPath}
        data-mobile-add-business
        class="fixed z-30 bottom-[calc(1rem+env(safe-area-inset-bottom))] right-[calc(1rem+env(safe-area-inset-right))] inline-flex min-h-11 items-center gap-2 rounded-full bg-cti-text px-4 text-sm font-semibold text-cti-surface shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cti-gold sm:hidden"
      >
        <span aria-hidden="true" class="text-lg leading-none">+</span>
        {addBusinessLabel}
      </a>
    )}

    <Footer currentLang={currentLang} />

    <style is:global>
      :root {
        color-scheme: light;
      }
      html, body {
        overflow-x: clip;
      }
      h1, h2, h3 {
        text-wrap: balance;
      }
      p {
        text-wrap: pretty;
      }
      input:user-invalid,
      select:user-invalid,
      textarea:user-invalid {
        border-color: #C53939;
      }
    </style>
  </body>
</html>
