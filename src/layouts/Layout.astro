---
import { activePreset, type Locale } from '../config/siteConfig';
import { resolveCategoryByRouteParam, getCategoryUrl } from '../data/categorySeo';
import { VERIFIED_CATEGORIES } from '../data/verifiedDirectory';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import freshness from '../data/freshness.json';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

interface Props {
  title: string;
  description: string;
  currentLang: Locale;
  currentPath?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  currentLang,
  currentPath = '',
  schema,
  noindex = !activePreset.allowIndexing,
} = Astro.props;

const canonicalPathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPathname, activePreset.siteUrl).href;

function getAlternateUrl(targetLang: Locale): string {
  const segments = Astro.url.pathname.split('/').filter(Boolean);
  if (segments.length === 0) {
    return `${activePreset.siteUrl}/${targetLang}/`;
  }
  if (segments.length >= 2 && activePreset.locales.includes(segments[0] as Locale)) {
    const matchedCat = resolveCategoryByRouteParam(segments[1], segments[0] as Locale);
    if (matchedCat) {
      const catUrl = getCategoryUrl(matchedCat.slug, targetLang);
      if (segments.length >= 3) {
        return `${activePreset.siteUrl}${catUrl}${segments[2]}/`;
      }
      return `${activePreset.siteUrl}${catUrl}`;
    }
  }
  if (activePreset.locales.includes(segments[0] as Locale)) {
    segments[0] = targetLang;
  } else {
    segments.unshift(targetLang);
  }
  return `${activePreset.siteUrl}/${segments.join('/')}/`;
}

const defaultLangUrl = getAlternateUrl(activePreset.defaultLocale);
const totalCompanies = VERIFIED_CATEGORIES.reduce((acc, cat) => acc + cat.items.length, 0);

const networkDomains = [
  'https://bakutopindex.com',
  'https://cyprustopindex.com',
  'https://aitopindex.com',
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: activePreset.siteName,
  url: activePreset.siteUrl,
  description: activePreset.missionStatement[currentLang],
  sameAs: ['https://bakutopindex.com', 'https://aitopindex.com'],
  parentOrganization: {
    '@type': 'Organization',
    name: 'TopIndex Network',
    sameAs: networkDomains,
  },
  areaServed: {
    '@type': 'Country',
    name: 'Cyprus',
  },
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: activePreset.siteName,
  url: activePreset.siteUrl,
  description: activePreset.tagline[currentLang],
  inLanguage: activePreset.locales,
  relatedLink: ['https://bakutopindex.com', 'https://aitopindex.com'],
  publisher: {
    '@type': 'Organization',
    name: 'TopIndex Network',
    url: activePreset.siteUrl,
    sameAs: networkDomains,
  },
};

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${activePreset.siteName} Verified Directory of Cyprus (${totalCompanies} listings)`,
  description: activePreset.tagline[currentLang],
  url: canonicalUrl,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  dateModified: freshness.lastVerified,
  isAccessibleForFree: true,
  inLanguage: currentLang,
  creator: {
    '@type': 'Organization',
    name: activePreset.siteName,
    url: activePreset.siteUrl,
  },
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: `${activePreset.siteUrl}/api/directory.json`,
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/plain',
      contentUrl: `${activePreset.siteUrl}/llms-full.txt`,
    },
  ],
};

const combinedSchemas = [
  organizationSchema,
  webSiteSchema,
  datasetSchema,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!doctype html>
<html lang={currentLang} dir="ltr" class="scroll-smooth antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23231F1B'/%3E%3Ctext x='16' y='22' text-anchor='middle' font-family='sans-serif' font-weight='bold' font-size='16' fill='%23DEC7A3'%3EC%3C/text%3E%3C/svg%3E" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="zFzrjxTXaXUfxpdqwswtKnFutcCFAxcR79bFGTsZSq0" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="dateModified" content={freshness.lastVerified} />
    <link rel="alternate" type="application/json" href={`${activePreset.siteUrl}/api/directory.json`} title="CyprusTopIndex Verified Open Dataset (JSON)" />
    <link rel="alternate" type="text/plain" href={`${activePreset.siteUrl}/llms.txt`} title="CyprusTopIndex LLM Summary" />

    {noindex ? (
      <>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
        <meta name="googlebot" content="index, follow" />
      </>
    )}

    {activePreset.locales.map((lang) => (
      <link rel="alternate" hreflang={lang} href={getAlternateUrl(lang)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultLangUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={activePreset.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={currentLang} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <JsonLd schema={combinedSchemas} />
  </head>
  <body class="bg-cti-bg text-cti-text font-sans min-h-screen flex flex-col selection:bg-cti-catActive selection:text-cti-text">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-cti-text focus:px-3 focus:py-2 focus:text-xs focus:font-semibold focus:text-cti-surface"
    >
      Skip to main content
    </a>

    <Header currentLang={currentLang} currentPath={currentPath} />

    <div id="main-content" class="flex-1">
      <slot />
    </div>

    {!currentPath.includes('/submit') && (
      <a
        href={`/${currentLang}/submit/`}
        aria-label={currentLang === 'el' ? 'Προσθήκη Επιχείρησης' : currentLang === 'ru' ? 'Добавить бизнес' : 'Add Business'}
        class="fixed bottom-4 right-4 sm:bottom-5 sm:right-5 z-40 inline-flex items-center gap-2 rounded-full bg-cti-text px-4 py-2.5 text-xs font-semibold text-cti-surface shadow-lg border border-cti-gold/40 hover:bg-cti-gold hover:text-cti-text transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cti-gold"
      >
        <span aria-hidden="true">+</span>
        <span>{currentLang === 'el' ? 'Προσθήκη' : currentLang === 'ru' ? 'Добавить бизнес' : 'Add Business'}</span>
      </a>
    )}

    <Footer currentLang={currentLang} />

    <style is:global>
      :root {
        color-scheme: light;
      }
      html, body {
        overflow-x: clip;
      }
      h1, h2, h3 {
        text-wrap: balance;
      }
      p {
        text-wrap: pretty;
      }
      input:user-invalid,
      select:user-invalid,
      textarea:user-invalid {
        border-color: #C53939;
      }
    </style>
  </body>
</html>
