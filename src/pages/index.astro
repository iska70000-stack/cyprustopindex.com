---
import Layout from '../layouts/Layout.astro';
import DirectoryMain from '../components/DirectoryMain.astro';
import type { Locale } from '../config/siteConfig';
import { VERIFIED_CATEGORIES } from '../data/verifiedDirectory';
import { CATEGORY_GUIDES } from '../data/categoryGuides';

const currentLang: Locale = 'en';

const title = 'CyprusTopIndex — Verified Businesses & Services in Cyprus (2026)';
const description =
  'Curated AI-ready directory of verified companies and specialists in Limassol, Nicosia, Larnaca, and Paphos with 2026 EUR (€) market benchmarks and direct contacts.';

const schemaItems = VERIFIED_CATEGORIES.flatMap((cat) =>
  cat.items.map((item) => ({
    '@type': 'LocalBusiness',
    name: item.name[currentLang] || item.name.en,
    description: item.description[currentLang] || item.description.en,
    address: {
      '@type': 'PostalAddress',
      streetAddress: item.address[currentLang] || item.address.en,
      addressLocality: item.city,
      addressCountry: 'CY',
    },
    ...(item.phones && item.phones.length > 0 ? { telephone: item.phones[0] } : {}),
    ...(item.website ? { url: item.website } : {}),
  }))
);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description,
  numberOfItems: schemaItems.length,
  itemListElement: schemaItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: Object.values(CATEGORY_GUIDES).flatMap((guide) =>
    guide.faqs.slice(0, 1).map((faq) => ({
      '@type': 'Question',
      name: faq.question[currentLang] || faq.question.en,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer[currentLang] || faq.answer.en,
      },
    }))
  ),
};

const combinedSchema = [itemListSchema, faqSchema];
---

<Layout
  title={title}
  description={description}
  currentLang={currentLang}
  currentPath="/"
  schema={combinedSchema}
>
  <DirectoryMain currentLang={currentLang} />
</Layout>
