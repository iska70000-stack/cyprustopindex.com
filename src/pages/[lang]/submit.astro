---
import Layout from '../../layouts/Layout.astro';
import { activePreset, type Locale } from '../../config/siteConfig';
import { VERIFIED_CATEGORIES } from '../../data/verifiedDirectory';
import { stripLeadingEmoji } from '../../utils/textUtils';

export async function getStaticPaths() {
  return activePreset.locales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as Locale) || 'en';
const apiUrl = import.meta.env.PUBLIC_SUBMISSIONS_API_URL || 'https://api.cyprustopindex.com/api/submissions';

const t = {
  en: {
    title: 'Add Business to CyprusTopIndex | Free Verification',
    desc: 'Submit your licensed company in Limassol, Nicosia, Larnaca, or Paphos for verification and priority listing.',
    h1: 'Add Business to CyprusTopIndex',
    subtitle: 'Fast editorial verification for companies and specialists in the Republic of Cyprus. No registration fee.',
    nameLabel: 'Business or Specialist Name *',
    catLabel: 'Industry Category *',
    cityLabel: 'City *',
    webLabel: 'Official Website',
    phoneLabel: 'Phone (+357) *',
    waLabel: 'WhatsApp (+357)',
    descLabel: 'Short Description (10–600 chars) *',
    logoLabel: 'Company Logo (optional, JPG/PNG/WebP, max 2 MB)',
    emailLabel: 'Contact Email (private, for status updates) *',
    submitBtn: 'Submit for Moderation',
    submittingBtn: 'Submitting...',
    confirmTitle: 'Application received for moderation!',
    confirmText:
      'Your application has been accepted for moderation. Want to speed up verification and get priority status? Place the Cyprus Top Index badge on your website or social media:',
    copyBadgeBtn: 'Copy HTML Badge Code',
    copiedBadgeBtn: 'Copied!',
    badgePreviewLabel: 'Badge Preview:',
  },
  el: {
    title: 'Προσθήκη Επιχείρησης | CyprusTopIndex',
    desc: 'Υποβάλετε την επιχείρησή σας σε Λεμεσό, Λευκωσία, Λάρνακα ή Πάφο για επαλήθευση.',
    h1: 'Προσθήκη Επιχείρησης στο CyprusTopIndex',
    subtitle: 'Γρήγορη συντακτική επαλήθευση για επιχειρήσεις στην Κυπριακή Δημοκρατία.',
    nameLabel: 'Επωνυμία Επιχείρησης *',
    catLabel: 'Κατηγορία Κλάδου *',
    cityLabel: 'Πόλη *',
    webLabel: 'Επίσημος Ιστότοπος',
    phoneLabel: 'Τηλέφωνο (+357) *',
    waLabel: 'WhatsApp (+357)',
    descLabel: 'Σύντομη Περιγραφή (10–600 χαρακτήρες) *',
    logoLabel: 'Λογότυπο (προαιρετικό, JPG/PNG/WebP, έως 2 MB)',
    emailLabel: 'Email Επικοινωνίας (ιδιωτικό) *',
    submitBtn: 'Υποβολή για Έλεγχο',
    submittingBtn: 'Αποστολή...',
    confirmTitle: 'Η αίτηση ελήφθη για έλεγχο!',
    confirmText:
      'Η αίτησή σας έγινε δεκτή για έλεγχο. Θέλετε να επιταχύνετε την επαλήθευση και να λάβετε προτεραιότητα; Τοποθετήστε το σήμα Cyprus Top Index στον ιστότοπό σας ή στα κοινωνικά δίκτυα:',
    copyBadgeBtn: 'Αντιγραφή Κώδικα HTML',
    copiedBadgeBtn: 'Αντιγράφηκε!',
    badgePreviewLabel: 'Προεπισκόπηση Σήματος:',
  },
  ru: {
    title: 'Добавить бизнес на Кипре | CyprusTopIndex',
    desc: 'Быстрая заявка на добавление компании в Лимассоле, Никосии, Ларнаке или Пафосе.',
    h1: 'Добавить бизнес в CyprusTopIndex',
    subtitle: 'Бесплатная проверка для компаний и специалистов Республики Кипр.',
    nameLabel: 'Название компании или имя специалиста *',
    catLabel: 'Сфера деятельности *',
    cityLabel: 'Город *',
    webLabel: 'Официальный сайт',
    phoneLabel: 'Телефон (+357) *',
    waLabel: 'WhatsApp (+357)',
    descLabel: 'Краткое описание услуг (10–600 символов) *',
    logoLabel: 'Логотип компании (необязательно, JPG/PNG/WebP до 2 МБ)',
    emailLabel: 'Email для уведомлений (не публикуется) *',
    submitBtn: 'Отправить на модерацию',
    submittingBtn: 'Отправка...',
    confirmTitle: 'Заявка принята на модерацию!',
    confirmText:
      'Заявка принята на модерацию. Хотите ускорить проверку и получить приоритетный статус? Разместите бейдж Cyprus Top Index на своем сайте или в соцсетях:',
    copyBadgeBtn: 'Скопировать HTML-код бейджа',
    copiedBadgeBtn: 'Скопировано!',
    badgePreviewLabel: 'Как выглядит бейдж:',
  },
}[currentLang];

const badgeHtmlSnippet = `<a href="https://cyprustopindex.com/${currentLang}/" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:10px;background:#FDFBF7;border:1px solid #DEC7A3;color:#231F1B;font-family:Inter,system-ui,sans-serif;font-size:13px;font-weight:700;text-decoration:none;"><span style="color:#2E7D43;">✔</span><span>Verified on <span style="color:#96784B;">CyprusTopIndex.com</span></span></a>`;
---

<Layout
  title={t.title}
  description={t.desc}
  currentLang={currentLang}
  currentPath={`/${currentLang}/submit/`}
>
  <main class="mx-auto max-w-2xl px-4 py-8 sm:px-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-cti-text leading-tight">{t.h1}</h1>
    <p class="mt-2 text-sm text-cti-muted leading-relaxed">{t.subtitle}</p>

    <form
      id="submitBusinessForm"
      data-api-url={apiUrl}
      data-lang={currentLang}
      class="mt-6 rounded-2xl bg-cti-surface border border-cti-border p-5 sm:p-6 space-y-4 shadow-[0_1px_4px_rgba(35,31,27,0.04)]"
    >
      <div>
        <label for="bizName" class="block text-xs font-semibold text-cti-text mb-1">{t.nameLabel}</label>
        <input
          id="bizName"
          name="name"
          type="text"
          required
          minlength="2"
          maxlength="120"
          autocomplete="organization"
          class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="bizCategory" class="block text-xs font-semibold text-cti-text mb-1">{t.catLabel}</label>
          <select
            id="bizCategory"
            name="categorySlug"
            required
            class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
          >
            {VERIFIED_CATEGORIES.map((cat) => (
              <option value={cat.slug}>{stripLeadingEmoji(cat.titles[currentLang])}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="bizCity" class="block text-xs font-semibold text-cti-text mb-1">{t.cityLabel}</label>
          <select
            id="bizCity"
            name="city"
            required
            autocomplete="address-level2"
            class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
          >
            {activePreset.cities.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="bizPhone" class="block text-xs font-semibold text-cti-text mb-1">{t.phoneLabel}</label>
          <input
            id="bizPhone"
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            placeholder="+357 25 000 000"
            class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
          />
        </div>

        <div>
          <label for="bizWa" class="block text-xs font-semibold text-cti-text mb-1">{t.waLabel}</label>
          <input
            id="bizWa"
            name="whatsapp"
            type="tel"
            placeholder="+357 99 000 000"
            class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="bizWebsite" class="block text-xs font-semibold text-cti-text mb-1">{t.webLabel}</label>
          <input
            id="bizWebsite"
            name="website"
            type="url"
            autocomplete="url"
            placeholder="https://example.com.cy"
            class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
          />
        </div>

        <div>
          <label for="bizEmail" class="block text-xs font-semibold text-cti-text mb-1">{t.emailLabel}</label>
          <input
            id="bizEmail"
            name="applicantEmail"
            type="email"
            required
            autocomplete="email"
            placeholder="info@example.com.cy"
            class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
          />
        </div>
      </div>

      <div>
        <label for="bizDesc" class="block text-xs font-semibold text-cti-text mb-1">{t.descLabel}</label>
        <textarea
          id="bizDesc"
          name="description"
          rows="3"
          required
          minlength="10"
          maxlength="600"
          class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill px-3.5 py-2 text-sm text-cti-text focus:border-cti-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-cti-gold/40"
        ></textarea>
      </div>

      <div>
        <label for="bizLogo" class="block text-xs font-semibold text-cti-text mb-1">{t.logoLabel}</label>
        <input
          id="bizLogo"
          name="logo"
          type="file"
          accept="image/png,image/jpeg,image/webp"
          class="block w-full text-xs text-cti-muted file:mr-3 file:rounded-lg file:border file:border-cti-border file:bg-cti-bar file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-cti-text hover:file:bg-cti-catInactive"
        />
      </div>

      <button
        id="submitBtn"
        type="submit"
        class="w-full sm:w-auto rounded-xl bg-cti-text px-5 py-2.5 text-sm font-semibold text-cti-surface hover:opacity-90 transition cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cti-gold"
      >
        {t.submitBtn}
      </button>
    </form>

    <!-- CONFIRMATION & PRIORITY BADGE SCREEN -->
    <section
      id="confirmationScreen"
      aria-live="polite"
      class="hidden mt-6 rounded-2xl bg-cti-surface border border-cti-gold p-6 shadow-md space-y-4"
    >
      <div class="flex items-center gap-2 text-cti-open font-bold text-base sm:text-lg">
        <span aria-hidden="true">✅</span>
        <h2>{t.confirmTitle}</h2>
      </div>

      <p class="text-sm text-cti-text leading-relaxed">{t.confirmText}</p>

      <div class="rounded-xl bg-cti-bar border border-cti-divider p-4 space-y-2">
        <div class="text-[11px] font-mono uppercase tracking-wider text-cti-muted">{t.badgePreviewLabel}</div>
        <div set:html={badgeHtmlSnippet} />
      </div>

      <div>
        <label for="badgeHtmlCode" class="sr-only">HTML Badge Code</label>
        <textarea
          id="badgeHtmlCode"
          readonly
          rows="3"
          class="w-full rounded-xl border border-cti-inputBorder bg-cti-pill p-3 font-mono text-xs text-cti-text focus:outline-none"
        >{badgeHtmlSnippet}</textarea>

        <button
          type="button"
          id="copyBadgeBtn"
          class="mt-2.5 inline-flex items-center gap-2 rounded-xl bg-cti-gold px-4 py-2 text-xs font-bold text-cti-surface hover:opacity-90 transition cursor-pointer"
        >
          {t.copyBadgeBtn}
        </button>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ submittingText: t.submittingBtn, submitText: t.submitBtn, copyText: t.copyBadgeBtn, copiedText: t.copiedBadgeBtn }}>
  const form = document.getElementById('submitBusinessForm');
  const submitBtn = document.getElementById('submitBtn');
  const confirmScreen = document.getElementById('confirmationScreen');
  const copyBtn = document.getElementById('copyBadgeBtn');
  const badgeCode = document.getElementById('badgeHtmlCode');
  const logoInput = document.getElementById('bizLogo');

  let imageDataUrl = '';
  logoInput?.addEventListener('change', () => {
    const file = logoInput.files?.[0];
    if (!file || file.size > 2 * 1024 * 1024) {
      imageDataUrl = '';
      return;
    }
    const reader = new FileReader();
    reader.onload = () => {
      imageDataUrl = typeof reader.result === 'string' ? reader.result : '';
    };
    reader.readAsDataURL(file);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = submittingText;
    }

    const fd = new FormData(form);
    const payload = {
      type: 'company',
      sourceLang: form.getAttribute('data-lang') || 'en',
      name: fd.get('name'),
      categorySlug: fd.get('categorySlug'),
      city: fd.get('city'),
      phone: fd.get('phone'),
      whatsapp: fd.get('whatsapp'),
      website: fd.get('website'),
      applicantEmail: fd.get('applicantEmail'),
      description: fd.get('description'),
      imageDataUrl,
    };

    const apiUrl = form.getAttribute('data-api-url');
    try {
      await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
    } catch {
      // Graceful fallback while api.cyprustopindex.com DNS is pending
    }

    form.classList.add('hidden');
    confirmScreen?.classList.remove('hidden');
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = submitText;
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!badgeCode) return;
    try {
      await navigator.clipboard.writeText(badgeCode.value);
      copyBtn.textContent = copiedText;
      setTimeout(() => {
        copyBtn.textContent = copyText;
      }, 2000);
    } catch {
      badgeCode.select();
    }
  });
</script>
