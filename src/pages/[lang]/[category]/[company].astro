---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { activePreset, type Locale } from '../../../config/siteConfig';
import { VERIFIED_CATEGORIES } from '../../../data/verifiedDirectory';
import { getCategoryRouteSlug, getCategoryUrl, getProfileUrl } from '../../../data/categorySeo';
import { sanitizePhone, sanitizeWhatsApp, stripLeadingEmoji } from '../../../utils/textUtils';
import { CITY_NAMES } from '../../../data/directoryLocations';
import { CATEGORY_GUIDES } from '../../../data/categoryGuides';
import { breadcrumbs, businessSchema } from '../../../data/directorySchema';
import { SELECTIONS, getCategoryCityUrl, getSelectionUrl } from '../../../data/directorySelections';

export async function getStaticPaths() {
  const paths: Array<{
    params: { lang: Locale; category: string; company: string };
    props: { catSlug: string; itemId: string; redirectTo?: string };
  }> = [];

  for (const lang of activePreset.locales) {
    for (const cat of VERIFIED_CATEGORIES) {
      const routeCat = getCategoryRouteSlug(cat.slug, lang);
      for (const item of cat.items) {
        paths.push({
          params: { lang, category: routeCat, company: item.id },
          props: { catSlug: cat.slug, itemId: item.id },
        });
        if (item.id === 'adamantio-dental-nicosia') {
          paths.push({
            params: { lang, category: routeCat, company: 'adamantio-dental-limassol' },
            props: { catSlug: cat.slug, itemId: item.id, redirectTo: getProfileUrl(cat.slug, item.id, lang) },
          });
        }
      }
    }
  }
  return paths;
}

const { lang } = Astro.params;
const { catSlug, itemId, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 308);
const currentLang = (lang as Locale) || 'en';

const cat = VERIFIED_CATEGORIES.find((c) => c.slug === catSlug) || VERIFIED_CATEGORIES[0];
const item = cat.items.find((i) => i.id === itemId) || cat.items[0];
const catUrl = getCategoryUrl(cat.slug, currentLang);
const cityName = CITY_NAMES[item.city][currentLang];
const profileUrl = getProfileUrl(cat.slug, item.id, currentLang);
const checkedDate = item.contactCheckedOn && new Intl.DateTimeFormat(currentLang, {
  dateStyle: 'medium', timeZone: 'UTC',
}).format(new Date(item.contactCheckedOn));
const guide = CATEGORY_GUIDES[cat.slug];
const immigrationSelection = SELECTIONS.find((selection) => selection.category === cat.slug && selection.listingNotes?.[item.id]);
const immigrationPractice = immigrationSelection?.listingNotes?.[item.id];
const practiceLabels = {
  en: ['Immigration services', 'Firm’s immigration practice'],
  el: ['Υπηρεσίες μετανάστευσης', 'Η μεταναστευτική πρακτική του γραφείου'],
  ru: ['Иммиграционные услуги', 'Иммиграционная практика фирмы'],
}[currentLang];

const itemName = item.name[currentLang] || item.name.en;
const itemDesc = item.description[currentLang] || item.description.en;
const itemAddr = item.address[currentLang] || item.address.en;
const itemSpec = item.agency?.[currentLang] || stripLeadingEmoji(cat.titles[currentLang]);
const cleanPhone = item.phones?.[0] ? sanitizePhone(item.phones[0]) : '';
const cleanWa = item.whatsapp ? sanitizeWhatsApp(item.whatsapp) : '';
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${item.name.en} ${item.address.en} Cyprus`)}`;

const titleByLanguage = {
  en: `${itemName} in ${cityName}`,
  el: `${itemName} | ${cityName}`,
  ru: `${itemName} — ${cityName}`,
};
const contactTitle = { en: 'Contact details', el: 'Επικοινωνία', ru: 'Контакты' }[currentLang];
const pageTitle = itemName.toLowerCase().includes(cityName.toLowerCase()) || item.city === 'Island-wide'
  ? `${itemName} | ${contactTitle}`
  : titleByLanguage[currentLang];
const profileMeta = {
  'budget-cyprus': {
    en: ['Budget Car Rental at Larnaca Airport (LCA)', 'Find the Budget rental desk at Larnaca Airport, its phone number and the official page for pickup, returns and reservations.'],
    el: ['Ενοικίαση Budget στο Αεροδρόμιο Λάρνακας (LCA)', 'Βρείτε το τηλέφωνο του γκισέ Budget στο αεροδρόμιο Λάρνακας και τον επίσημο ιστότοπο για κράτηση και όρους παραλαβής.'],
    ru: ['Прокат Budget в аэропорту Ларнаки (LCA)', 'Телефон стойки Budget в аэропорту Ларнаки и официальный сайт для бронирования и проверки условий получения и возврата.'],
  },
  'evangelismos-hospital-paphos': {
    en: ['Evangelismos Private Hospital, Paphos', 'Find Evangelismos Private Hospital’s address and phone in Paphos. See the official contacts and information about its 24-hour emergency department.'],
    el: ['Ιδιωτικό Νοσοκομείο Ευαγγελισμός στην Πάφο', 'Βρείτε τη διεύθυνση και το τηλέφωνο του νοσοκομείου Ευαγγελισμός στην Πάφο, με σύνδεσμο για τα επίσημα στοιχεία επικοινωνίας.'],
    ru: ['Госпиталь Evangelismos в Пафосе — адрес и телефон', 'Адрес и телефон госпиталя Evangelismos в Пафосе. Круглосуточное отделение неотложной помощи и ссылка на контакты больницы.'],
  },
} as Record<string, Record<Locale, [string, string]>>;
const customMeta = profileMeta[item.id]?.[currentLang];
const pageDesc = itemDesc.length > 158
  ? itemDesc.slice(0, itemDesc.lastIndexOf(' ', 155)) + '…'
  : itemDesc;

const alternatives = cat.items.filter((entry) => entry.id !== item.id);
const nearby = alternatives.filter((entry) => entry.city === item.city);
const related = (nearby.length ? nearby : alternatives).slice(0, 3);
const localizedCategory = stripLeadingEmoji(cat.titles[currentLang]);

const labels = {
  en: {
    home: 'Home',
    checked: 'Contact details checked',
    website: 'Official website',
    related: 'Other providers in this category',
    sameCity: 'Browse this category by city',
    address: 'Address',
    city: 'City',
    phone: 'Phone',
    call: 'Call Now',
    whatsapp: 'Message on WhatsApp',
    map: 'Map',
    back: 'Back to category',
  },
  el: {
    home: 'Αρχική',
    checked: 'Έλεγχος στοιχείων επικοινωνίας',
    website: 'Επίσημος ιστότοπος',
    related: 'Άλλοι πάροχοι στην ίδια κατηγορία',
    sameCity: 'Προβολή κατηγορίας ανά πόλη',
    address: 'Διεύθυνση',
    city: 'Πόλη',
    phone: 'Τηλέφωνο',
    call: 'Κλήση',
    whatsapp: 'Μήνυμα WhatsApp',
    map: 'Χάρτης',
    back: 'Επιστροφή στην κατηγορία',
  },
  ru: {
    home: 'Главная',
    checked: 'Контакты сверены',
    website: 'Официальный сайт',
    related: 'Другие компании в этой категории',
    sameCity: 'Смотреть категорию в этом городе',
    address: 'Адрес',
    city: 'Город',
    phone: 'Телефон',
    call: 'Позвонить',
    whatsapp: 'Написать в WhatsApp',
    map: 'Карта',
    back: 'Назад в категорию',
  },
}[currentLang];
const trail = [
  { name: labels.home, path: `/${currentLang}/` },
  { name: localizedCategory, path: catUrl },
  { name: itemName, path: profileUrl },
];
---

<Layout
  title={customMeta?.[0] || pageTitle}
  description={customMeta?.[1] || pageDesc}
  currentLang={currentLang}
  currentPath={profileUrl}
  schema={[businessSchema(cat, item, currentLang), breadcrumbs(trail)]}
>
  <main class="mx-auto max-w-4xl px-4 py-5 sm:py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-5 text-xs text-cti-muted flex flex-wrap items-center gap-1.5">
      <a href={`/${currentLang}/`} class="hover:text-cti-text">{labels.home}</a>
      <span aria-hidden="true">/</span>
      <a href={catUrl} class="hover:text-cti-text">{stripLeadingEmoji(cat.titles[currentLang])}</a>
      <span aria-hidden="true">/</span>
      <span class="text-cti-text font-medium" aria-current="page">{itemName}</span>
    </nav>

    <article class="rounded-2xl bg-cti-surface border border-cti-border p-4 sm:p-6 shadow-[0_1px_4px_rgba(35,31,27,0.04)]">
      <p class="mb-2 text-sm font-medium text-cti-muted">{cityName}</p>

      <h1 class="text-2xl sm:text-3xl font-bold text-cti-text leading-tight">{itemName}</h1>
      <p class="mt-1.5 text-sm font-medium text-cti-gold">{itemSpec}</p>
      <p class="mt-4 text-base text-cti-text leading-relaxed">{itemDesc}</p>

      <div class="mt-4 flex flex-wrap gap-2.5">
        {cleanPhone && (
          <a
            href={`tel:${cleanPhone}`}
            class="inline-flex items-center gap-2 rounded-xl bg-cti-text min-h-11 px-4 py-2.5 text-sm font-semibold text-cti-surface hover:opacity-90 transition"
          >
            <Icon name="phone" class="w-4 h-4" />
            <span>{labels.call}</span>
          </a>
        )}
        {cleanWa && (
          <a
            href={`https://wa.me/${cleanWa}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-cti-gold bg-cti-bar min-h-11 px-4 py-2.5 text-sm font-semibold text-cti-text hover:bg-cti-catActive transition"
          >
            <span>{labels.whatsapp}</span>
          </a>
        )}
        <a
          href={mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-cti-border bg-cti-surface min-h-11 px-4 py-2.5 text-sm font-medium text-cti-text hover:border-cti-gold transition"
        >
          <Icon name="map-pin" class="w-4 h-4 text-cti-gold" />
          <span>{labels.map}</span>
        </a>
        {item.website && (
          <a href={item.website} class="inline-flex min-h-11 items-center rounded-xl border border-cti-border px-4 text-sm font-medium hover:border-cti-gold">
            {labels.website}
          </a>
        )}
      </div>

      <dl class="mt-5 grid gap-3 border-t border-cti-divider pt-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-cti-muted">{labels.address}</dt>
          <dd class="mt-1 font-medium">{itemAddr}</dd>
        </div>
        {cleanPhone && (
          <div>
            <dt class="text-cti-muted">{labels.phone}</dt>
            <dd class="mt-1 font-medium">
              {item.phones?.map((phone) => (
                <a href={`tel:${sanitizePhone(phone)}`} class="block w-fit underline decoration-cti-gold underline-offset-4">{phone}</a>
              ))}
            </dd>
          </div>
        )}
      </dl>
      {checkedDate && (
        <p class="mt-4 text-sm text-cti-muted">
          {labels.checked} · <time datetime={item.contactCheckedOn}>{checkedDate}</time>
        </p>
      )}
      {immigrationSelection && immigrationPractice && (
        <section class="mt-4 border-t border-cti-divider pt-4">
          <h2 class="text-base font-bold">{practiceLabels[0]}</h2>
          <p class="mt-1 text-sm leading-relaxed">{immigrationPractice.text[currentLang]}</p>
          <div class="mt-1 flex flex-wrap gap-x-5">
            <a href={immigrationPractice.source} class="inline-flex min-h-11 items-center text-sm font-semibold underline decoration-cti-gold underline-offset-4">
              {practiceLabels[1]}
            </a>
            <a href={getSelectionUrl(currentLang, immigrationSelection.slug)} class="inline-flex min-h-11 items-center text-sm font-semibold underline decoration-cti-gold underline-offset-4">
              {immigrationSelection.name[currentLang]}
            </a>
          </div>
        </section>
      )}
      {guide && <a class="mt-3 inline-flex min-h-10 items-center text-sm font-semibold underline decoration-cti-gold underline-offset-4" href={guide.source}>{guide.sourceLabel[currentLang]}</a>}
    </article>

    {related.length > 0 && (
      <section class="mt-7" aria-labelledby="related-heading">
        <h2 id="related-heading" class="text-lg font-bold">{labels.related}</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-3">
          {related.map((entry) => (
            <li>
              <a href={getProfileUrl(cat.slug, entry.id, currentLang)} class="block rounded-xl border border-cti-border bg-cti-surface p-3 hover:border-cti-gold">
                <span class="block font-semibold">{entry.name[currentLang]}</span>
                <span class="mt-1 block text-sm text-cti-muted">{CITY_NAMES[entry.city][currentLang]}</span>
                {entry.agency && <span class="mt-1 block text-sm">{entry.agency[currentLang]}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <a href={nearby.length ? getCategoryCityUrl(cat.slug, item.city, currentLang) : catUrl} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold underline decoration-cti-gold underline-offset-4">
      {nearby.length ? labels.sameCity : labels.back}
    </a>
  </main>
</Layout>
