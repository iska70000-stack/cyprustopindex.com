---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { activePreset, type Locale } from '../../../config/siteConfig';
import { VERIFIED_CATEGORIES } from '../../../data/verifiedDirectory';
import { getCategoryRouteSlug, getCategoryUrl } from '../../../data/categorySeo';
import { sanitizePhone, sanitizeWhatsApp, stripLeadingEmoji } from '../../../utils/textUtils';
import freshness from '../../../data/freshness.json';

export async function getStaticPaths() {
  const paths: Array<{
    params: { lang: Locale; category: string; company: string };
    props: { catSlug: string; itemId: string };
  }> = [];

  for (const lang of activePreset.locales) {
    for (const cat of VERIFIED_CATEGORIES) {
      const routeCat = getCategoryRouteSlug(cat.slug, lang);
      for (const item of cat.items) {
        paths.push({
          params: { lang, category: routeCat, company: item.id },
          props: { catSlug: cat.slug, itemId: item.id },
        });
      }
    }
  }
  return paths;
}

const { lang } = Astro.params;
const { catSlug, itemId } = Astro.props;
const currentLang = (lang as Locale) || 'en';

const cat = VERIFIED_CATEGORIES.find((c) => c.slug === catSlug) || VERIFIED_CATEGORIES[0];
const item = cat.items.find((i) => i.id === itemId) || cat.items[0];
const catUrl = getCategoryUrl(cat.slug, currentLang);
const localizedRouteSlug = getCategoryRouteSlug(cat.slug, currentLang);
const formattedDate = (freshness.formattedDate as Record<Locale, string>)[currentLang] || freshness.lastVerified;

const itemName = item.name[currentLang] || item.name.en;
const itemDesc = item.description[currentLang] || item.description.en;
const itemAddr = item.address[currentLang] || item.address.en;
const itemSpec = item.agency?.[currentLang] || stripLeadingEmoji(cat.titles[currentLang]);
const cleanPhone = item.phones?.[0] ? sanitizePhone(item.phones[0]) : '';
const cleanWa = item.whatsapp ? sanitizeWhatsApp(item.whatsapp) : '';
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${item.name.en} ${item.address.en} Cyprus`)}`;

const pageTitle = `${itemName} (${item.city}, Cyprus) — Verified Dossier | CyprusTopIndex`;
const pageDesc = `${itemDesc} Address: ${itemAddr}.`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${activePreset.siteUrl}${catUrl}${item.id}/`,
  name: itemName,
  description: itemDesc,
  address: {
    '@type': 'PostalAddress',
    streetAddress: itemAddr,
    addressLocality: item.city,
    addressCountry: 'CY',
  },
  ...(item.phones && item.phones.length > 0 ? { telephone: item.phones[0] } : {}),
  ...(item.website ? { url: item.website } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: currentLang === 'ru' ? 'Главная' : currentLang === 'el' ? 'Αρχική' : 'Home',
      item: `${activePreset.siteUrl}/${currentLang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: stripLeadingEmoji(cat.titles[currentLang]),
      item: `${activePreset.siteUrl}${catUrl}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: itemName,
      item: `${activePreset.siteUrl}${catUrl}${item.id}/`,
    },
  ],
};

const labels = {
  en: {
    home: 'Home',
    verified: `Verified ${formattedDate}`,
    address: 'Address',
    city: 'City',
    phone: 'Phone',
    languages: 'Languages',
    call: 'Call Now',
    whatsapp: 'Message on WhatsApp',
    map: 'Open in Google Maps',
    back: 'Back to category',
  },
  el: {
    home: 'Αρχική',
    verified: `Επαληθεύτηκε ${formattedDate}`,
    address: 'Διεύθυνση',
    city: 'Πόλη',
    phone: 'Τηλέφωνο',
    languages: 'Γλώσσες',
    call: 'Κλήση',
    whatsapp: 'Μήνυμα WhatsApp',
    map: 'Άνοιγμα στο Google Maps',
    back: 'Επιστροφή στην κατηγορία',
  },
  ru: {
    home: 'Главная',
    verified: `Проверено ${formattedDate}`,
    address: 'Адрес',
    city: 'Город',
    phone: 'Телефон',
    languages: 'Языки',
    call: 'Позвонить',
    whatsapp: 'Написать в WhatsApp',
    map: 'Открыть на карте',
    back: 'Назад в категорию',
  },
}[currentLang];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  currentLang={currentLang}
  currentPath={`/${currentLang}/${localizedRouteSlug}/${item.id}/`}
  schema={[localBusinessSchema, breadcrumbSchema]}
>
  <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-5 text-xs text-cti-muted flex flex-wrap items-center gap-1.5">
      <a href={`/${currentLang}/`} class="hover:text-cti-text">{labels.home}</a>
      <span aria-hidden="true">/</span>
      <a href={catUrl} class="hover:text-cti-text">{stripLeadingEmoji(cat.titles[currentLang])}</a>
      <span aria-hidden="true">/</span>
      <span class="text-cti-text font-medium" aria-current="page">{itemName}</span>
    </nav>

    <article class="rounded-2xl bg-cti-surface border border-cti-border p-6 shadow-[0_1px_4px_rgba(35,31,27,0.04)]">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-cti-bar border border-cti-divider px-3 py-1 text-[11px] font-mono text-cti-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-cti-open" aria-hidden="true"></span>
          <span>{labels.verified}</span>
        </span>
        <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-cti-bar border border-cti-divider text-cti-text">
          {item.city}, Cyprus
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-cti-text leading-tight">{itemName}</h1>
      <p class="mt-1.5 text-sm font-medium text-cti-gold">{itemSpec}</p>
      <p class="mt-4 text-sm sm:text-base text-cti-text leading-relaxed">{itemDesc}</p>

      <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 border-t border-cti-divider pt-5 text-xs sm:text-sm">
        <div class="rounded-xl bg-cti-bar border border-cti-divider p-3">
          <dt class="text-[11px] font-mono uppercase text-cti-muted">{labels.address}</dt>
          <dd class="mt-1 font-medium text-cti-text">{itemAddr}</dd>
        </div>

        {item.phones && item.phones.length > 0 && (
          <div class="rounded-xl bg-cti-bar border border-cti-divider p-3">
            <dt class="text-[11px] font-mono uppercase text-cti-muted">{labels.phone}</dt>
            <dd class="mt-1 font-mono font-semibold text-cti-text">{item.phones[0]}</dd>
          </div>
        )}

        {item.languages && (
          <div class="rounded-xl bg-cti-bar border border-cti-divider p-3">
            <dt class="text-[11px] font-mono uppercase text-cti-muted">{labels.languages}</dt>
            <dd class="mt-1 font-mono font-medium text-cti-text">{item.languages.join(' • ')}</dd>
          </div>
        )}

        <div class="rounded-xl bg-cti-bar border border-cti-divider p-3">
          <dt class="text-[11px] font-mono uppercase text-cti-muted">{labels.city}</dt>
          <dd class="mt-1 font-medium text-cti-text">{item.city}, Republic of Cyprus</dd>
        </div>
      </dl>

      <div class="mt-6 flex flex-wrap gap-2.5">
        {cleanPhone && (
          <a
            href={`tel:${cleanPhone}`}
            class="inline-flex items-center gap-2 rounded-xl bg-cti-text px-4 py-2.5 text-xs sm:text-sm font-semibold text-cti-surface hover:opacity-90 transition"
          >
            <Icon name="phone" class="w-4 h-4" />
            <span>{labels.call}</span>
          </a>
        )}
        {cleanWa && (
          <a
            href={`https://wa.me/${cleanWa}`}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-cti-gold bg-cti-bar px-4 py-2.5 text-xs sm:text-sm font-semibold text-cti-text hover:bg-cti-catActive transition"
          >
            <span>{labels.whatsapp}</span>
          </a>
        )}
        <a
          href={mapUrl}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-cti-border bg-cti-surface px-4 py-2.5 text-xs sm:text-sm font-medium text-cti-text hover:border-cti-gold transition"
        >
          <Icon name="map-pin" class="w-4 h-4 text-cti-gold" />
          <span>{labels.map}</span>
        </a>
      </div>
    </article>

    <div class="mt-6">
      <a href={catUrl} class="text-xs font-semibold text-cti-gold hover:text-cti-text transition-colors">
        ← {labels.back}
      </a>
    </div>
  </main>
</Layout>
