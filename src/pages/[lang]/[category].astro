---
import Layout from '../../layouts/Layout.astro';
import DirectoryMain from '../../components/DirectoryMain.astro';
import { activePreset, type Locale } from '../../config/siteConfig';
import { VERIFIED_CATEGORIES } from '../../data/verifiedDirectory';
import { breadcrumbs, businessList } from '../../data/directorySchema';
import {
  getCategoryRouteSlug,
  getCategorySeoMeta,
  resolveCategoryByRouteParam,
} from '../../data/categorySeo';

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: Locale; category: string } }> = [];
  for (const lang of activePreset.locales) {
    for (const cat of VERIFIED_CATEGORIES) {
      paths.push({
        params: { lang, category: getCategoryRouteSlug(cat.slug, lang) },
      });
    }
  }
  return paths;
}

const { lang, category } = Astro.params;
const currentLang = (lang as Locale) || 'en';
const activeCat = resolveCategoryByRouteParam(category || '', currentLang) || VERIFIED_CATEGORIES[0];
const canonicalSlug = activeCat.slug;
const localizedRouteSlug = getCategoryRouteSlug(canonicalSlug, currentLang);
const seoMeta = getCategorySeoMeta(activeCat, currentLang);

const pagePath = `/${currentLang}/${localizedRouteSlug}/`;
const homeLabel = { en: 'Home', el: 'Αρχική', ru: 'Главная' }[currentLang];
const combinedSchema = [
  businessList(activeCat, currentLang, pagePath, seoMeta.h1),
  breadcrumbs([{ name: homeLabel, path: `/${currentLang}/` }, { name: seoMeta.h1, path: pagePath }]),
];
---

<Layout
  title={seoMeta.title}
  description={seoMeta.description}
  currentLang={currentLang}
  currentPath={pagePath}
  schema={combinedSchema}
>
  <DirectoryMain
    currentLang={currentLang}
    activeCategorySlug={canonicalSlug}
    isCategoryPage={true}
  />
</Layout>
