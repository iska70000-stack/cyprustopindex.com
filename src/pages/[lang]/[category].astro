---
import Layout from '../../layouts/Layout.astro';
import DirectoryMain from '../../components/DirectoryMain.astro';
import { activePreset, type Locale } from '../../config/siteConfig';
import { VERIFIED_CATEGORIES } from '../../data/verifiedDirectory';
import { CATEGORY_GUIDES } from '../../data/categoryGuides';
import {
  getCategoryRouteSlug,
  getCategorySeoMeta,
  resolveCategoryByRouteParam,
} from '../../data/categorySeo';

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: Locale; category: string } }> = [];
  for (const lang of activePreset.locales) {
    for (const cat of VERIFIED_CATEGORIES) {
      paths.push({
        params: { lang, category: getCategoryRouteSlug(cat.slug, lang) },
      });
    }
  }
  return paths;
}

const { lang, category } = Astro.params;
const currentLang = (lang as Locale) || 'en';
const activeCat = resolveCategoryByRouteParam(category || '', currentLang) || VERIFIED_CATEGORIES[0];
const canonicalSlug = activeCat.slug;
const localizedRouteSlug = getCategoryRouteSlug(canonicalSlug, currentLang);
const seoMeta = getCategorySeoMeta(activeCat, currentLang);

const schemaItems = activeCat.items.map((item, idx) => ({
  '@type': 'ListItem',
  position: idx + 1,
  item: {
    '@type': 'LocalBusiness',
    '@id': `${activePreset.siteUrl}/${currentLang}/${localizedRouteSlug}/#${item.id}`,
    name: item.name[currentLang] || item.name.en,
    description: item.description[currentLang] || item.description.en,
    address: {
      '@type': 'PostalAddress',
      streetAddress: item.address[currentLang] || item.address.en,
      addressLocality: item.city,
      addressCountry: 'CY',
    },
    ...(item.phones && item.phones.length > 0 ? { telephone: item.phones[0] } : {}),
    ...(item.website ? { url: item.website } : {}),
  },
}));

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: seoMeta.h1,
  description: seoMeta.description,
  url: `${activePreset.siteUrl}/${currentLang}/${localizedRouteSlug}/`,
  numberOfItems: schemaItems.length,
  itemListElement: schemaItems,
};

const guide = CATEGORY_GUIDES[canonicalSlug];
const faqSchema = guide
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: guide.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question[currentLang] || faq.question.en,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer[currentLang] || faq.answer.en,
        },
      })),
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: currentLang === 'ru' ? 'Главная' : currentLang === 'el' ? 'Αρχική' : 'Home',
      item: `${activePreset.siteUrl}/${currentLang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: activeCat.titles[currentLang] || activeCat.titles.en,
      item: `${activePreset.siteUrl}/${currentLang}/${localizedRouteSlug}/`,
    },
  ],
};

const combinedSchema = [
  itemListSchema,
  breadcrumbSchema,
  ...(faqSchema ? [faqSchema] : []),
];
---

<Layout
  title={seoMeta.title}
  description={seoMeta.description}
  currentLang={currentLang}
  currentPath={`/${currentLang}/${localizedRouteSlug}/`}
  schema={combinedSchema}
>
  <DirectoryMain
    currentLang={currentLang}
    activeCategorySlug={canonicalSlug}
    isCategoryPage={true}
  />
</Layout>
