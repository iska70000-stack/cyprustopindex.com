---
import Layout from '../../../layouts/Layout.astro';
import DirectoryMain from '../../../components/DirectoryMain.astro';
import { activePreset, type Locale } from '../../../config/siteConfig';
import { getCategorySeoMeta, getCategoryUrl } from '../../../data/categorySeo';
import { SELECTIONS, getSelectionCategory, getSelectionUrl } from '../../../data/directorySelections';
import { breadcrumbs, businessList } from '../../../data/directorySchema';

export function getStaticPaths() {
  return activePreset.locales.flatMap((lang) => SELECTIONS.map((selection) => ({
    params: { lang, selection: selection.slug },
    props: { selection },
  })));
}

const lang = Astro.params.lang as Locale;
const { selection } = Astro.props;
const category = getSelectionCategory(selection);
const title = selection.name[lang];
const introduction = selection.intro[lang];
const [firstSentence] = introduction.split('. ');
const description = firstSentence.endsWith('.') ? firstSentence : `${firstSentence}.`;
const path = getSelectionUrl(lang, selection.slug);
const categoryUrl = getCategoryUrl(category.slug, lang);
const parentName = getCategorySeoMeta(category, lang).h1;
const homeLabel = { en: 'Home', el: 'Αρχική', ru: 'Главная' }[lang];
const trail = [
  { name: homeLabel, path: `/${lang}/` },
  { name: parentName, path: categoryUrl },
  { name: title, path },
];
---

<Layout
  title={title}
  description={description}
  currentLang={lang}
  currentPath={path}
  schema={[businessList(category, lang, path, title), breadcrumbs(trail)]}
>
  <DirectoryMain
    currentLang={lang}
    activeCategorySlug={category.slug}
    isCategoryPage
    selection={{
      slug: selection.slug,
      title,
      intro: introduction,
      category,
      guide: selection.guide,
      listingNotes: selection.listingNotes,
    }}
  />
</Layout>
