---
import Layout from '../../layouts/Layout.astro';
import DirectoryMain from '../../components/DirectoryMain.astro';
import { activePreset, type Locale } from '../../config/siteConfig';
import { VERIFIED_CATEGORIES } from '../../data/verifiedDirectory';
import { HOME_COPY, getCategoryUrl, getCategorySeoMeta } from '../../data/categorySeo';

export async function getStaticPaths() {
  return activePreset.locales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as Locale) || 'en';

const [title, description] = HOME_COPY[currentLang];
const categoryList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  itemListElement: VERIFIED_CATEGORIES.map((cat, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: getCategorySeoMeta(cat, currentLang).h1,
    url: `${activePreset.siteUrl}${getCategoryUrl(cat.slug, currentLang)}`,
  })),
};
---

<Layout
  title={title}
  description={description}
  currentLang={currentLang}
  currentPath={`/${currentLang}/`}
  schema={categoryList}
>
  <DirectoryMain currentLang={currentLang} />
</Layout>
