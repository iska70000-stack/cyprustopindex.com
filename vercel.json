{
  "redirects": [
    { "source": "/", "destination": "/en/", "permanent": true },
    { "source": "/en/medical-dental/adamantio-dental-limassol/", "destination": "/en/medical-dental/adamantio-dental-nicosia/", "permanent": true },
    { "source": "/el/iatrikes-klinikes/adamantio-dental-limassol/", "destination": "/el/iatrikes-klinikes/adamantio-dental-nicosia/", "permanent": true },
    { "source": "/ru/kliniki-stomatologiya/adamantio-dental-limassol/", "destination": "/ru/kliniki-stomatologiya/adamantio-dental-nicosia/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/submissions", "destination": "https://api.bakutopindex.com/api/cyprus/submissions" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
